# Le bazar de Laura — modèle de configuration (copier vers .env.local)

# PostgreSQL (base dédiée, rôle applicatif à privilèges minimaux)
DATABASE_URL=postgres://bazar_app:motdepasse@localhost:5432/bazar_laura

# Auth.js
AUTH_SECRET=                         # générer : openssl rand -base64 32
AUTH_URL=http://localhost:3000       # URL du VPS en prod

# Stockage des couvertures uploadées
UPLOAD_DIR=./uploads/covers          # chemin disque
NEXT_PUBLIC_UPLOAD_BASE_URL=/uploads/covers   # URL publique servie par le reverse proxy

# Lookup ISBN (optionnel)
GOOGLE_BOOKS_API_KEY=

# Recherche de couvertures via Google Images (optionnel — API Custom Search)
# Permet d'afficher de vraies couvertures Google Images dans le sélecteur.
GOOGLE_SEARCH_API_KEY=                 # clé API avec « Custom Search API » activée (sinon réutilise GOOGLE_BOOKS_API_KEY)
GOOGLE_CSE_ID=                         # ID du moteur Programmable Search (cx), recherche d'images sur tout le web

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=         # format international sans '+' ni espaces, ex: 66XXXXXXXXX
NEXT_PUBLIC_LINE_ID=
