# Production — copier vers /opt/bazar/.env.local sur le VPS (NE PAS committer).
# ⚠️ Les variables NEXT_PUBLIC_* sont injectées au BUILD (`next build` lit .env.local) :
#    définis-les AVANT de builder, sinon elles seront vides dans le bundle client.

# --- PostgreSQL local du VPS (port 5432 par défaut) ---
DATABASE_URL=postgres://bazar_app:MOTDEPASSE_FORT@127.0.0.1:5432/bazar_laura

# --- Lookup ISBN (métadonnées) : clé Google Books (gratuite, ~1000 req/jour) ---
# Indispensable pour des fiches fiables au scan (sinon on dépend de la BnF, capricieuse).
GOOGLE_BOOKS_API_KEY=

# --- (optionnel) Recherche Google Images dans le sélecteur de couverture ---
# Quota 100/jour → on s'en passe (epagine couvre l'essentiel). Laisser vide.
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# --- Stockage des couvertures uploadées ---
# ⚠️ CHEMIN ABSOLU en prod : le serveur standalone tourne avec cwd=.next/standalone,
#    un chemin relatif pointerait au mauvais endroit.
UPLOAD_DIR=/opt/bazar/uploads/covers
NEXT_PUBLIC_UPLOAD_BASE_URL=/uploads/covers

# --- Contact (NEXT_PUBLIC → injecté au build) ---
# Numéro WhatsApp au format international sans '+' ni espaces, ex : 66XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINE_ID=

# --- Serveur Node (standalone) ---
PORT=3000
HOSTNAME=127.0.0.1
NODE_ENV=production
