# systemd — service de l'app. Copier vers /etc/systemd/system/bazar.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bazar
# Logs : journalctl -u bazar -f
#
# NB : déploiement auto-hébergé simple → on tourne depuis le HOME de l'utilisateur
#      manu (pas de /opt/bazar ni d'utilisateur système dédié).

[Unit]
Description=Le bazar de Laura (Next.js standalone)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=manu
WorkingDirectory=/home/manu/lebazardelaura
# Charge DATABASE_URL, GOOGLE_BOOKS_API_KEY, UPLOAD_DIR, PORT, HOSTNAME, etc.
EnvironmentFile=/home/manu/lebazardelaura/.env.local
ExecStart=/usr/bin/node /home/manu/lebazardelaura/.next/standalone/server.js
Restart=always
RestartSec=3
# Durcissement léger (le HOME reste accessible en écriture pour les uploads)
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
